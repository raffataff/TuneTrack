# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# TuneTrack machine-specific / large / regenerable data
library/plugins.json
library/state.json
library/config.json
library/server.log
library/audition/
library/auditions/
library/instruments/
library/vst3/
# patches made from the locally installed free plugins in library/vst3/
library/patches/surge-xt-*
library/patches/dexed-*
library/.params_*
projects/*/cache/
projects/*/history/
projects/*/renders/
# studio session state: the board (seats, tasks, messages) and agents' working copies
projects/*/studio/
projects/*/takes/
library/agents.json

# per-project edit lock (held while an operation edits project.json)
.lock
*.tmp

# scratch output from other tools (design mockups etc.)
output/
