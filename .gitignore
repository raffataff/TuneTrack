# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# TuneTrack machine-specific / large / regenerable data
library/plugins.json
library/state.json
library/config.json
library/server.log
library/audition/
library/auditions/
library/instruments/
library/vst3/
# patches made from the locally installed free plugins in library/vst3/
library/patches/surge-xt-*
library/patches/dexed-*
library/.params_*
library/agents.json
# per-session crew usage, keyed by local project paths
library/crew_history.json

# your songs: every project (project.json, audio, renders, studio board, takes) stays on this machine
projects/

# per-project edit lock (held while an operation edits project.json)
.lock
*.tmp

# scratch output from other tools (design mockups etc.)
output/
