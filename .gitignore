# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# TuneTrack machine-specific / large / regenerable data
library/plugins.json
library/state.json
library/config.json
library/server.log
library/audition/
library/auditions/
library/instruments/
library/vst3/
# patches made from the locally installed free plugins in library/vst3/
library/patches/surge-xt-*
library/patches/dexed-*
library/.params_*
library/agents.json
# the UI's layout, the desktop app's browser profile, which gear the user has seen, the live audition's session
library/ui.json
library/app-profile/
library/gear.json
library/audition-live/
# per-session crew usage, keyed by local project paths
library/crew_history.json

# your songs: every project (project.json, audio, renders, studio board, takes) stays on this machine
projects/

# per-project edit lock (held while an operation edits project.json)
.lock
*.tmp

# scratch output from other tools (design mockups etc.)
output/

# the sfizz source release (50 MB) and the sfizz plugin installer's uninstaller: engine/README.md says how to get it
engine/third_party/sfizz/
# the crew's knowledge: notes distilled from the user's own books, and lessons learned from their sessions
library/knowledge/
library/lessons/
